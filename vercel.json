{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd server && npm install && npm run db:generate && npm run build && cd ../src/frontend && pnpm install --prefer-offline && pnpm build",
  "devCommand": "cd src/frontend && pnpm dev",
  "installCommand": "echo 'install handled in buildCommand'",
  "outputDirectory": "src/frontend/dist",
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/favicon.ico", "destination": "/favicon.ico" },
    { "source": "/favicon.svg", "destination": "/favicon.svg" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
