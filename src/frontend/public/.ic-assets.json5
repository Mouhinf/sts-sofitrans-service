  {
    "match": "**/*",
    "security_policy": "standard",
    "headers": {
      "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:4943 http://localhost:4943 http://*.localhost:4943 https://icp0.io https://*.icp0.io https://icp-api.io; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src 'self' http://rdmx6-jaaaa-aaaaa-aaadq-cai.localhost:4943 http://127.0.0.1:4943"
    }
  }
]
